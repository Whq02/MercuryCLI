{
  "name": "mercury",
  "version": "1.0.0-beta.1",
  "description": "Mercury \u2014 a private, standalone software-development harness (source-built terminal agent), built with bun",
  "repository": {
    "type": "git",
    "url": "https://github.com/Whq02/PreRelease.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "setup": "bun install && bun run scripts/vendor/fetch-pyright.ts && bun run scripts/vendor/fetch-debugpy.ts && bun run scripts/vendor/fetch-js-debug.ts && bun run scripts/vendor/fetch-grammars.ts && bun run scripts/vendor/fetch-node.ts",
    "build": "bun run build.ts",
    "start": "node dist/mercury.mjs",
    "typecheck": "bash scripts/typecheck/run-all.sh",
    "verify:fast": "bun run scripts/verify/fast.ts",
    "gate:ledger": "bun run scripts/gate/ledger.ts",
    "verify": "bash scripts/run-all-suites.sh",
    "artifact:smoke": "bun run scripts/build/prove-isolated-artifact.ts",
    "version:check": "bun run scripts/updater/prove-version-contract.ts",
    "version:sync": "bun run scripts/distribution/generate-third-party-notices.ts && bun run scripts/updater/prove-version-contract.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@anthropic-ai/mcpb": "2.1.2",
    "@anthropic-ai/sandbox-runtime": "0.0.74",
    "@anthropic-ai/sdk": "0.122.0",
    "@commander-js/extra-typings": "~15.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@puppeteer/browsers": "3.2.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "ajv": "8.20.0",
    "auto-bind": "5.0.1",
    "axios": "1.20.0",
    "bidi-js": "1.0.3",
    "chalk": "6.0.0",
    "chokidar": "5.0.0",
    "cli-boxes": "4.0.1",
    "commander": "~15.0.0",
    "diff": "9.0.0",
    "emoji-regex": "10.6.0",
    "env-paths": "4.0.0",
    "execa": "10.0.1",
    "fflate": "0.8.3",
    "figures": "6.1.0",
    "fuse.js": "7.5.0",
    "get-east-asian-width": "1.6.0",
    "highlight.js": "11.12.0",
    "https-proxy-agent": "9.1.0",
    "ignore": "7.0.6",
    "indent-string": "5.0.0",
    "jsonc-parser": "3.3.1",
    "lodash-es": "4.18.1",
    "lru-cache": "11.5.2",
    "marked": "18.0.11",
    "p-map": "7.0.7",
    "picomatch": "4.0.7",
    "proper-lockfile": "4.1.2",
    "puppeteer-core": "25.9.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-reconciler": "0.33.0",
    "semver": "7.8.5",
    "sharp": "^0.35.4",
    "shell-quote": "1.10.0",
    "signal-exit": "4.1.0",
    "strip-ansi": "7.2.0",
    "supports-hyperlinks": "4.5.0",
    "turndown": "^7.2.4",
    "undici": "8.10.0",
    "usehooks-ts": "3.1.1",
    "vscode-css-languageservice": "6.3.10",
    "vscode-html-languageservice": "5.6.2",
    "vscode-json-languageservice": "5.7.2",
    "vscode-jsonrpc": "9.0.2",
    "vscode-languageserver-protocol": "3.18.3",
    "vscode-languageserver-textdocument": "1.0.14",
    "wrap-ansi": "10.0.1",
    "ws": "8.21.3",
    "yaml": "^2.9.0",
    "yaml-language-server": "1.24.0",
    "zod": "~4.5.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-reconciler": "0.33.0",
    "@types/semver": "^7.8.0",
    "@types/shell-quote": "^1.7.5",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vscode/ripgrep": "^1.18.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "fast-check": "4.9.0",
    "typescript": "^6.0.3"
  }
}
