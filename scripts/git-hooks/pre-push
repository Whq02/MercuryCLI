#!/usr/bin/env bash
set -euo pipefail
remote_name="${1:-}"
remote_url="${2:-}"
case "${remote_url}${remote_name}" in
  *MercuryCLI*|*mercurycli*)
    if [ "${MERCURY_PUBLIC_PUSH:-}" != "1" ]; then
      printf 'pre-push: refused — %s is the PUBLIC repository. A public push is the operator'"'"'s word: rerun as  MERCURY_PUBLIC_PUSH=1 git push %s …\n' "${remote_url:-$remote_name}" "$remote_name" >&2
      exit 1
    fi
    ;;
esac
exit 0
