diff --git a/greet.mjs b/greet.mjs
--- a/greet.mjs
+++ b/greet.mjs
@@ -1 +1,6 @@
-console.log("hello, " + process.argv[2]);
+const args = process.argv.slice(2);
+const name = (args[0] ?? "").trim().normalize("NFC");
+const valid = args.length === 1 && name.length !== 0;
+const output = valid ? process.stdout : process.stderr;
+output.write(valid ? ["hello, ", name, "\n"].join("") : "usage: greet <name>\n");
+process.exitCode = valid ? 0 : 2;
