+    #[tokio::test]
+    async fn only_posix_runtime_programs_get_words_written_for_that_runtime() -> Result<(), Box<dyn std::error::Error>> {
+        let dir = tempfile::tempdir()?;
+        let mut shell = Shell::builder().build().await?;
+        shell.set_working_dir(dir.path())?;
+        let params = shell.default_exec_params();
+        let context = ExecutionContext {
+            shell: &mut shell,
+            command_name: "probe".into(),
+            params,
+        };
+        let words = ["*.ts", r"a b\\c", r"C:\Program Files\x", "plain", ""];
+        let written = [r#""*.ts""#, r#""a b\\\\c""#, r#"C":\Program Files\x""#, "plain", r#""""#];
+        for (folder, runtime) in [("msys", Some("msys-2.0.dll")), ("cygwin", Some("cygwin1.dll")), ("native", None)] {
+            let folder = dir.path().join(folder);
+            std::fs::create_dir_all(&folder)?;
+            if let Some(runtime) = runtime {
+                std::fs::write(folder.join(runtime), "")?;
+            }
+            for (program, batch_file) in [
+                ("probe.exe", false), ("probe", false), ("probe.cmd", true), ("probe.BAT", true),
+                ("probe.cmd.", true), ("probe.cmd ", true), ("probe.BAT. .", true), (".cmd", true), (".BAT", true),
+                (r"probe.cmd\.", true),
+            ] {
+                let name = folder.join(program);
+                let name = name.to_str().ok_or("non-UTF-8 scratch directory")?;
+                let cmd = compose_std_command(&context, name, name, &words, false)?;
+                let args = cmd.get_args().collect::<Vec<_>>();
+                if runtime.is_some() && !batch_file {
+                    assert_eq!(args, written, "{name}");
+                } else {
+                    assert_eq!(args, words, "{name}");
+                }
+            }
+        }
+        let trap = dir.path().join("trap.cmd").join("x");
+        std::fs::create_dir_all(&trap)?;
+        std::fs::write(trap.join("msys-2.0.dll"), "")?;
+        let name = trap.join("..");
+        let name = name.to_str().ok_or("non-UTF-8 scratch directory")?;
+        let cmd = compose_std_command(&context, name, name, &words, false)?;
+        assert_eq!(cmd.get_args().collect::<Vec<_>>(), words, "{name}");
+        for name in ["./bad\".cmd.", "./bad\n.cmd ", "./bad\r.BAT. .", "./bad\n/.cmd"] {
+            assert!(compose_std_command(&context, name, name, &[] as &[&str], false).is_err());
+        }
+        Ok(())
+    }
+}
