+// Whether the standard library may start `program` through cmd.exe. Its own test
+// (`Command::spawn` on Windows) reads the last four characters of the path as
+// `GetFullPathNameW` leaves it, or of the path as given when it is verbatim. This
+// one is never narrower: it reads the path as given and as that call leaves it,
+// each with the periods, spaces and separators at its end taken off (Windows
+// drops trailing periods and spaces from a name, and a last segment that is one
+// period), and takes a path that cannot be resolved for a batch file.
+#[cfg(windows)]
+fn names_batch_file(program: &Path) -> bool {
+    let batch_name = |path: &Path| {
+        let mut name = path.as_os_str().as_encoded_bytes();
+        while let [rest @ .., b'.' | b' ' | b'\\' | b'/'] = name {
+            name = rest;
+        }
+        name.last_chunk::<4>().is_some_and(|ext| {
+            ext.eq_ignore_ascii_case(b".cmd") || ext.eq_ignore_ascii_case(b".bat")
+        })
+    };
+    batch_name(program) || std::path::absolute(program).map_or(true, |full| batch_name(&full))
+}
