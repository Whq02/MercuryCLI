+#[cfg(all(test, windows))]
+mod windows_command_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn paths_are_shell_relative_without_implicit_cwd_search() -> Result<(), Box<dyn std::error::Error>> {
+        let dir = tempfile::tempdir()?;
+        let cwd = dir.path().join("work");
+        let bin = dir.path().join("bin");
+        std::fs::create_dir_all(&cwd)?;
+        std::fs::create_dir_all(&bin)?;
+        std::fs::write(cwd.join("cwd-only.cmd"), "@echo CWD_SHIM_MUST_NOT_RUN\r\n")?;
+        std::fs::write(bin.join("shim-probe.cmd"), "@echo PATH_SHIM_OK\r\n")?;
+        std::fs::write(bin.join("npm"), "#!/bin/sh\necho POSIX_SHIM\n")?;
+        std::fs::write(bin.join("npm.cmd"), "@echo PATH_SHIM_OK\r\n")?;
+        let mut shell = Shell::builder().build().await?;
+        shell.set_working_dir(&cwd)?;
+        let mut path_val = bin.as_os_str().to_os_string();
+        path_val.push(if cfg!(windows) { ";" } else { ":" });
+        shell.env_mut().set_global(
+            "PATH",
+            variables::ShellVariable::new(path_val.to_string_lossy().into_owned()),
+        )?;
+        if cfg!(windows) {
+            assert_eq!(
+                shell.find_first_executable_in_path_using_cache("shim-probe"),
+                Some(bin.join("shim-probe.cmd"))
+            );
+            assert_eq!(
+                shell.find_first_executable_in_path_using_cache("npm"),
+                Some(bin.join("npm.cmd"))
+            );
+        }
+        assert!(shell.find_first_executable_in_path_using_cache("cwd-only").is_none());
+        assert!(shell.find_first_executable_in_path_using_cache("cwd-only.cmd").is_none());
+        let params = shell.default_exec_params();
+        let context = ExecutionContext {
+            shell: &mut shell,
+            command_name: "probe".into(),
+            params: params.clone(),
+        };
+        for name in ["./probe.exe", "../probe.exe", "sub/probe.exe"] {
+            let cmd = compose_std_command(&context, name, name, &["%VAR%", "^", "a b"], false)?;
+            assert_eq!(Path::new(cmd.get_program()), context.shell.working_dir().join(name));
+            assert_eq!(cmd.get_current_dir(), Some(context.shell.working_dir()));
+            assert_eq!(cmd.get_args().collect::<Vec<_>>(), ["%VAR%", "^", "a b"]);
+        }
+        if cfg!(windows) {
+            let name = r".\probe.exe";
+            let cmd = compose_std_command(&context, name, name, &[] as &[&str], false)?;
+            assert_eq!(Path::new(cmd.get_program()), context.shell.working_dir().join(name));
+        }
+        let absolute = bin.join("shim-probe.cmd");
+        let name = absolute.to_str().ok_or("non-UTF-8 scratch directory")?;
+        let cmd = compose_std_command(&context, name, name, &["%VAR%", "^"], false)?;
+        assert_eq!(Path::new(cmd.get_program()), absolute);
+        assert_eq!(cmd.get_args().collect::<Vec<_>>(), ["%VAR%", "^"]);
+        for name in ["./bad\".cmd", "./bad\n.cmd", "./bad\r.bat"] {
+            assert!(compose_std_command(&context, name, name, &[] as &[&str], false).is_err());
+        }
+        assert!(pathsearch::search_for_executable([&bin].into_iter(), "cwd-only.cmd").next().is_none());
+        let mut command = SimpleCommand::new(
+            ShellForCommand::ParentShell(&mut shell), params, "cwd-only.cmd".into(),
+            vec![CommandArg::String("cwd-only.cmd".into())],
+        );
+        command.path_dirs = Some(vec![bin]);
+        assert!(command.execute().await.is_err());
+        Ok(())
+    }
+}
