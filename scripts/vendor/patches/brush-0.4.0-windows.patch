+// Writes one argument for a program of the MSYS2 or Cygwin runtime. Started by a
+// parent outside that runtime, such a program reads its command line by rules of
+// its own (dcrt0.cc: build_argv, quoted, globify) rather than Microsoft's: a word
+// that holds none of its trigger characters is taken as it stands, and any other
+// word arrives as given only when enclosed in double quotes. A leading drive
+// letter stays outside the quotes so that the word is never read as a DOS path,
+// where upstream Cygwin keeps backslashes by another rule.
+#[cfg(windows)]
+fn posix_runtime_arg(word: &str) -> String {
+    let taken_as_it_stands = !word.is_empty()
+        && !word.starts_with(['~', '@'])
+        && !word.contains([
+            ' ', '\t', '\n', '\r', '"', '\'', '?', '*', '[', '(', ')', '{', '}',
+        ]);
+    if taken_as_it_stands {
+        return word.to_owned();
+    }
+    let mut written = String::with_capacity(word.len() + 2);
+    let mut rest = word;
+    let mut start = word.chars();
+    if let (Some(drive), Some(':')) = (start.next(), start.next()) {
+        if drive.is_alphabetic() {
+            written.push(drive);
+            rest = word.strip_prefix(drive).unwrap_or(word);
+        }
+    }
+    written.push('"');
+    let mut backslashes = 0;
+    for c in rest.chars() {
+        if c == '\\' {
+            backslashes += 1;
+            continue;
+        }
+        if backslashes > 1 || c == '"' {
+            backslashes *= 2;
+        }
+        written.extend(std::iter::repeat_n('\\', backslashes));
+        backslashes = 0;
+        if c == '"' {
+            written.push('\\');
+        }
+        written.push(c);
+    }
+    written.extend(std::iter::repeat_n('\\', backslashes * 2));
+    written.push('"');
+    written
+}
