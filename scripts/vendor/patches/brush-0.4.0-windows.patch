+    #[test]
+    fn posix_runtime_words_are_written_for_that_runtime() {
+        for (word, written) in [
+            (r#""description":"effort-probe""#, r#""\"description\":\"effort-probe\"""#),
+            (r#"*.ts"#, r#""*.ts""#),
+            (r#"@list.txt"#, r#""@list.txt""#),
+            (r#"p q"r"#, r#""p q\"r""#),
+            (r#"a b\\c"#, r#""a b\\\\c""#),
+            (r#""#, r#""""#),
+            (r#"a b"#, r#""a b""#),
+            ("a\tb", "\"a\tb\""),
+            (r#" "#, r#"" ""#),
+            (r#"dir\"#, r#"dir\"#),
+            (r#"my dir\"#, r#""my dir\\""#),
+            (r#"a b\\"#, r#""a b\\\\""#),
+            (r#"\\server\share"#, r#"\\server\share"#),
+            (r#"\\server\share dir"#, r#""\\\\server\share dir""#),
+            (r#"C:\Program Files\x"#, r#"C":\Program Files\x""#),
+            (r#"C:\\x"#, r#"C:\\x"#),
+            (r#"C:\dir\"#, r#"C:\dir\"#),
+            (r#"C:\\x y"#, r#"C":\\\\x y""#),
+            (r#"C:\my dir\"#, r#"C":\my dir\\""#),
+            (r#"C:\a "b""#, r#"C":\a \"b\"""#),
+            (r#"C:"#, r#"C:"#),
+            (r#"s:a b:"#, r#"s":a b:""#),
+            (r#"a\\b"#, r#"a\\b"#),
+            (r#"a\b c"#, r#""a\b c""#),
+            (r#"\"#, r#"\"#),
+            (r#"'single'"#, r#""'single'""#),
+            (r#"it's"#, r#""it's""#),
+            (r#"$HOME"#, r#"$HOME"#),
+            (r#"%VAR%"#, r#"%VAR%"#),
+            (r#"^"#, r#"^"#),
+            ("a\nb", "\"a\nb\""),
+            ("a\rb", "\"a\rb\""),
+            (r#"~user"#, r#""~user""#),
+            (r#"~"#, r#""~""#),
+            (r#"a~b"#, r#"a~b"#),
+            (r#"{a,b}"#, r#""{a,b}""#),
+            (r#"{print $1}"#, r#""{print $1}""#),
+            (r#"(x)"#, r#""(x)""#),
+            (r#"[ab]"#, r#""[ab]""#),
+            (r#"[ab].ts"#, r#""[ab].ts""#),
+            (r#"*"#, r#""*""#),
+            (r#"?"#, r#""?""#),
+            (r#"?.ts"#, r#""?.ts""#),
+            (r#"--include=*.ts"#, r#""--include=*.ts""#),
+            (r#"@"#, r#""@""#),
+            (r#"a@b"#, r#"a@b"#),
+            (r#"-n"#, r#"-n"#),
+            ("na\u{ef}ve", "na\u{ef}ve"),
+            ("\u{65e5}\u{672c}\u{8a9e}", "\u{65e5}\u{672c}\u{8a9e}"),
+            ("\u{e9} t", "\"\u{e9} t\""),
+            ("\u{e9}:x y", "\u{e9}\":x y\""),
+            (r#"""#, r#""\"""#),
+            (r#"\""#, r#""\\\"""#),
+            (r#"\\""#, r#""\\\\\"""#),
+            (r#"s/"a"/"b"/"#, r#""s/\"a\"/\"b\"/""#),
+            (r#""key":"#, r#""\"key\":""#),
+        ] {
+            assert_eq!(posix_runtime_arg(word), written, "{word:?}");
+        }
+    }
