{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "models": {
      "description": "Model facts keyed by the full id: contextWindow, maxOutputTokens, prices, efforts, images, reasoning and thinkingBudget (the thinking-token cap a wire that documents one takes); _default maps provider families to facts for unknown ids; recorded capabilities are never reduced",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "contextWindow": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "maxOutputTokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "prices": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "output": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cacheRead": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cacheWrite": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "efforts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              },
              "images": {
                "type": "boolean"
              },
              "reasoning": {
                "type": "boolean"
              },
              "thinkingBudget": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "contextWindow": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxOutputTokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "prices": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "number",
                      "minimum": 0
                    },
                    "output": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cacheRead": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cacheWrite": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "efforts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "none",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                },
                "images": {
                  "type": "boolean"
                },
                "reasoning": {
                  "type": "boolean"
                },
                "thinkingBudget": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            }
          }
        ]
      }
    },
    "compatProvider": {
      "description": "Custom endpoints keyed by name, or one endpoint named default: baseUrl, label, models, headers, sessionAffinityHeader and dialect; keys are kept by /logins, not in settings",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "keyCommand": {
              "type": "string"
            },
            "hostPodId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "headers": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "sessionAffinityHeader": {
              "type": "string",
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            },
            "dialect": {
              "type": "string",
              "enum": [
                "chat-completions",
                "responses",
                "ollama",
                "lmstudio",
                "vllm",
                "sglang",
                "llamacpp"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "keyCommand": {
                "type": "string"
              },
              "hostPodId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "sessionAffinityHeader": {
                "type": "string",
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              },
              "dialect": {
                "type": "string",
                "enum": [
                  "chat-completions",
                  "responses",
                  "ollama",
                  "lmstudio",
                  "vllm",
                  "sglang",
                  "llamacpp"
                ]
              }
            },
            "required": [
              "baseUrl"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "videoProvider": {
      "description": "Named video generators: kind (minimax), optional baseUrl and model; billable calls use the existing /logins minimax key, never a key in settings",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "minimax"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "keyCommand": {
          "type": "string"
        },
        "keyCommands": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "signInRoute": {
          "type": "string",
          "enum": [
            "claudeai",
            "console"
          ]
        },
        "organisation": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "files": {
      "type": "object",
      "properties": {
        "suggester": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "command": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "command"
          ],
          "additionalProperties": false
        },
        "honourGitignore": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "records": {
      "type": "object",
      "properties": {
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": {}
    },
    "briefs": {
      "type": "object",
      "properties": {
        "exclude": {
          "description": "Glob patterns or absolute paths of instruction files to skip (e.g. ~/.mercury/MERCURY.md or **/.mercury/rules/*.md); managed layers cannot be excluded",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "git": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "enum": [
            "auto",
            "native"
          ]
        }
      },
      "additionalProperties": {}
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "description": "Where memory is written (default under the Mercury config home); ignored when set by checked-in project settings",
          "type": "string"
        },
        "embeddingModel": {
          "description": "Which embedding model memory ranks recall by meaning with, beside the word match: a model name this install carries (the shipped default), or the path of a gguf file; a name or path that resolves nowhere leaves memory on word match only and the front page says so",
          "type": "string"
        },
        "pinnedLimit": {
          "description": "How much pinned memory text (characters) loads into every session before Mercury says the shelf is full; every pinned rule still loads past it (default 8000)",
          "type": "integer",
          "minimum": 1000,
          "maximum": 9007199254740991
        },
        "startLimit": {
          "description": "How much memory text (characters) rides at the start of a session beyond the pinned rules, which always ride whole: the facts and earlier notes most relevant to the branch, the files touched lately and the last note, until the allowance is used (default 4000); what is left out is a Recall away",
          "type": "integer",
          "minimum": 1000,
          "maximum": 9007199254740991
        },
        "tellEngineSwitch": {
          "description": "Tell the model when its engine is switched: with it on, one line reaches the model at the switch naming the new engine and the time; off (the default), a switch is invisible to the model — the /model rows stay your record, and the model learns its engine by reading mercury://seat",
          "type": "boolean"
        },
        "journal": {
          "description": "The session journal (default off): when `true`, at session end the model writes a brief entry — where the project is, the queued backlog, the operator's constraints — into a file in the Mercury home beside the project's memory, never under the project tree, never pushed, synced or shared by Mercury",
          "type": "boolean"
        },
        "journalOnEntryPage": {
          "description": "The journal's last entry on the entry page the model reads at session start (default off); what the model reads at entry travels to the engine's provider with the request — never uploaded means Mercury itself never pushes, syncs or shares the journal, not that the session's own engine does not see it",
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "turns": {
      "type": "object",
      "properties": {
        "loopGuard": {
          "description": "Loop guard turn end: when true, the second detection of one repeated cycle of tool calls (or one chanted stretch of reply text) ends the turn with a loop_stopped result; absent or false, these cycles only draw reminders; crewmates and headless runs still end after three consecutive identical failing tool calls",
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "environment": {
      "type": "object",
      "properties": {
        "values": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
    },
    "credit": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string"
            },
            "pr": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "mercury": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "guardrails": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ask": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "default",
            "dontAsk",
            "implement",
            "sovereign",
            "flow",
            "apollo"
          ]
        },
        "disableSovereignMode": {
          "description": "True closes Sovereign mode for every session that reads this file",
          "type": "boolean"
        },
        "disableFlowMode": {
          "description": "True closes Flow for every session that reads this file",
          "type": "boolean"
        },
        "reasons": {
          "description": "The words a refusal or a consent card says for a rule, keyed by the rule spelling as written in allow, deny or ask",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "managedOnly": {
          "type": "boolean"
        },
        "sovereignConsentSeen": {
          "description": "True skips the consent card shown before entering Sovereign mode (honoured from the user, local, flag and policy sources)",
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "engine": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "roster": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabledProviders": {
          "description": "Provider families switched off: their rows leave the model picker and mercury://models, their bare words stop resolving, their stored keys remain untouched, and a session already on a disabled family keeps running",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backups": {
          "description": "The backup engines, in order: when the engine in use cannot answer a turn (its provider overloaded past the retry ladder, unreachable, refusing the sign-in after a refresh, or not serving the model), the turn hops to the first backup, then the next; a --backup-model heads the list; each engine is tried once per turn, and with no list nothing changes",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pins": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "sessionDefaults": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "usageNotice": {
          "description": "Usage notice to the model — with it on, the model is told when the session's usage window or spending limit is near (80% and 90%); off, the model is told nothing and only you see the meters",
          "type": "boolean"
        },
        "agent": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "kit": {
      "type": "object",
      "properties": {
        "trustProjectServers": {
          "type": "boolean"
        },
        "projectOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectOff": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "serverName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "serverCommand": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "serverUrl": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "serverName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "serverCommand": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "serverUrl": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "managedOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "events": {
      "type": "object",
      "properties": {
        "hooks": {
          "description": "The hooks, by event: one entry per hook with its own match; the Hooks page of the built-in docs defines the events and the entry — ask Mercury how hooks work (the mercury-docs skill reads docs/HOOKS.md, shipped inside Mercury)",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "turn.start",
              "turn.answer",
              "turn.end",
              "tool.before",
              "tool.after",
              "permission.ask",
              "permission.decided",
              "crewmate.start",
              "crewmate.end",
              "compaction.before",
              "compaction.after",
              "session.start",
              "session.end",
              "session.state",
              "file.changed"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "run": {
                  "description": "A shell command; the payload arrives on stdin",
                  "type": "string",
                  "minLength": 1
                },
                "question": {
                  "description": "A question a model answers; $EVENT is replaced by the payload JSON",
                  "type": "string",
                  "minLength": 1
                },
                "crewmate": {
                  "description": "A brief a crewmate with tools checks; $EVENT as above",
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "description": "The words every line about the hook uses, and the status row while it runs",
                  "type": "string"
                },
                "match": {
                  "description": "Names (Bash, Read|Edit) or a regular expression, matched against the event's match field",
                  "type": "string"
                },
                "shell": {
                  "description": "The shell a command runs in; bash unless set",
                  "type": "string",
                  "enum": [
                    "bash",
                    "powershell"
                  ]
                },
                "model": {
                  "description": "The model a question or crewmate hook runs on",
                  "type": "string"
                },
                "timeout": {
                  "description": "Seconds before the hook is ended: 600 for a run, 30 for a question, 60 for a crewmate",
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 2147483
                },
                "background": {
                  "description": "A run hook that does not hold the moment; its answer arrives at the next turn",
                  "type": "boolean"
                },
                "wake": {
                  "description": "A background run hook whose block wakes the model",
                  "type": "boolean"
                },
                "once": {
                  "description": "Runs once in a session, then stands down",
                  "type": "boolean"
                },
                "watch": {
                  "description": "file.changed only: the files to watch, relative to the project",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "disabled": {
          "description": "True turns off every hook that is not managed; in the managed layer, every hook",
          "type": "boolean"
        },
        "managedOnly": {
          "description": "True in the managed layer runs only the managed layer's hooks",
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "extensions": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "wanted": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "exclusive": {
          "description": "Managed lock restricting customization surfaces to extensions (filesystem sources such as the config home's skills directory are skipped for locked surfaces)",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "skills",
                  "agents",
                  "hooks",
                  "mcp"
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "activity": {
      "type": "object",
      "properties": {
        "tips": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "words": {
              "type": "object",
              "properties": {
                "excludeDefault": {
                  "type": "boolean"
                },
                "tips": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "tips"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": {}
        },
        "verbs": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "append",
                "replace"
              ]
            },
            "verbs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "mode",
            "verbs"
          ],
          "additionalProperties": false
        },
        "progress": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "view": {
      "type": "object",
      "properties": {
        "files": {
          "type": "boolean"
        },
        "modelPicker": {
          "type": "object",
          "properties": {
            "centred": {
              "description": "Where the model picker opens over the chat: centred (the default), or false for the left edge",
              "type": "boolean"
            }
          },
          "additionalProperties": {}
        },
        "syntaxOff": {
          "type": "boolean"
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "backgroundKey": {
          "type": "boolean"
        },
        "firstRunCards": {
          "description": "Where the first-run cards sit: centred on the screen with the trust tone in brown (the default), or top-left with the amber tone",
          "type": "string",
          "enum": [
            "centred",
            "top-left"
          ]
        },
        "ping": {
          "description": "Ping the terminal once when a chat finishes its turn while you are away (an iTerm2 notification there, the bell elsewhere); on unless set to false",
          "type": "boolean"
        },
        "accountIdentity": {
          "description": "Account identity on the screens: shown unless set to false; hidden takes every signed-in address, username and key tail off the screens (for a recording) and leaves the account word, while the Logins screen, /accounts and the health report still name the account",
          "type": "boolean"
        },
        "zen": {
          "description": "Zen mode: true hides the lanes and vitals rails and the chat takes the full width of the terminal (the rail-less layout narrow terminals already get); off unless set to true; /zen flips it and the Zen mode row of /config shows it",
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "context": {
      "type": "object",
      "properties": {
        "wayBack": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "input": {
      "type": "object",
      "properties": {
        "suggestions": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "shell": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "bash",
            "powershell"
          ]
        },
        "engine": {
          "type": "string",
          "enum": [
            "system",
            "brush"
          ]
        },
        "sessions": {
          "description": "The ceiling on live shell-engine sessions Mercury keeps at once: the main conversation's own plus that many minus one for crewmates (default 8). A crewmate past the ceiling waits for a free session, never sharing another owner's; a ceiling of 1 leaves no session for crewmates",
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "filterOutput": {
          "description": "Filter a shell command's output before the model reads it (default off): progress-bar redraws collapse to their last line, package-manager install chatter is dropped, a run of three or more identical lines folds to one with its count, and a footer names what was left out and the file holding the raw output; an output the filter would leave whole is unchanged",
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "patience": {
      "description": "Patience with a quiet model: normal (a 6 min stream-idle budget where keep-alives feed the watchdog, 15 min on the quiet roads, a 15 min non-streamed fallback ceiling, a 20 min retry budget), patient (every wait doubled), or the custom numbers; MERCURY_STREAM_IDLE_TIMEOUT_MS, MERCURY_API_TIMEOUT_MS and MERCURY_RECOVERY_BUDGET_MINUTES outrank it",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "normal",
            "patient"
          ]
        },
        {
          "type": "object",
          "properties": {
            "streamIdleSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "quietStreamIdleSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fallbackCeilingSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "recoveryBudgetMinutes": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "Custom patience: the stream-idle budget in seconds on the roads whose keep-alives feed the watchdog, the same budget on the quiet roads (silent while the model reasons), the non-streamed fallback ceiling in seconds, and the retry budget in minutes (0 = no budget); a missing number takes the normal one"
        }
      ]
    },
    "routing": {
      "type": "object",
      "properties": {
        "openrouter": {
          "description": "OpenRouter routing policy: denies data collection and requires every parameter by default, even when absent, with fallbacks on and zero data retention off; an explicit all-off setting (dataCollection: allow, requireParameters: false, allowFallbacks: true, zeroDataRetention: false) sends no routing preference",
          "type": "object",
          "properties": {
            "dataCollection": {
              "type": "string",
              "enum": [
                "allow",
                "deny"
              ]
            },
            "requireParameters": {
              "type": "boolean"
            },
            "allowFallbacks": {
              "type": "boolean"
            },
            "zeroDataRetention": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "openai": {
          "description": "The OpenAI API-key road's transport: http (the default) posts every request; websocket keeps one connection per conversation and sends only the new input against the previous response, falling back to http on any connect or stream fault before the response begins",
          "type": "object",
          "properties": {
            "transport": {
              "type": "string",
              "enum": [
                "http",
                "websocket"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {}
    },
    "channels": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "apollo": {
      "description": "Apollo Mode: pre-flight interview poll budget (default 7)",
      "type": "object",
      "properties": {
        "preflightQuestions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "worktree": {
          "type": "object",
          "properties": {
            "symlinkDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sparsePaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prepare": {
              "description": "A shell command run inside every new worktree after git makes it and before any seat uses it; a failure is named on the row",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {}
    },
    "local": {
      "type": "object",
      "properties": {
        "server": {
          "description": "The local model server's own knobs, written into its launch form (a launch agent plist, a systemd override) and applied by a restart only on your confirmation from /config; the values Mercury would write, beside the running server's own",
          "type": "object",
          "properties": {
            "maxLoadedModels": {
              "description": "How many models the local server keeps loaded at once (OLLAMA_MAX_LOADED_MODELS; the server documents 3 per GPU when unset)",
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "parallelSlots": {
              "description": "How many requests one loaded model answers at once, each slot holding its own window of cache (OLLAMA_NUM_PARALLEL; the server documents 1 when unset)",
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "keepAlive": {
              "description": "How long an idle model stays loaded (OLLAMA_KEEP_ALIVE; the server documents 5m when unset)",
              "type": "string",
              "pattern": "^(-?\\d+|-?(\\d+(\\.\\d+)?(ns|us|\\u00B5s|ms|s|m|h))+)$"
            },
            "contextLength": {
              "description": "The context length a request gets when it names none (OLLAMA_CONTEXT_LENGTH; the server documents 4096 when unset)",
              "type": "integer",
              "minimum": 512,
              "maximum": 10485760
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {}
    }
  },
  "additionalProperties": {}
}
