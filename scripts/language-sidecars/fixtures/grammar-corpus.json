 "hcl": {
  "main.tf": [
   "# Infrastructure for the tide service",
   "terraform {",
   "  required_version = \">= 1.6\"",
   "  required_providers {",
   "    aws = {",
   "      source  = \"hashicorp/aws\"",
   "      version = \"~> 5.40\"",
   "    }",
   "  }",
   "  backend \"s3\" {",
   "    bucket = \"tidepool-state\"",
   "    key    = \"prod/terraform.tfstate\"",
   "  }",
   "}",
   "",
   "variable \"environment\" {",
   "  type        = string",
   "  description = \"Deployment environment\"",
   "  default     = \"staging\"",
   "  validation {",
   "    condition     = contains([\"staging\", \"prod\"], var.environment)",
   "    error_message = \"environment must be staging or prod.\"",
   "  }",
   "}",
   "",
   "variable \"subnets\" {",
   "  type = map(object({",
   "    cidr   = string",
   "    public = optional(bool, false)",
   "  }))",
   "  default = {}",
   "}",
   "",
   "locals {",
   "  name_prefix = \"tidepool-${var.environment}\"",
   "  common_tags = merge(var.extra_tags, { Service = \"tidepool\", Managed = true })",
   "  ports       = [80, 443, 8080]",
   "  upper_names = [for s in keys(var.subnets) : upper(s) if s != \"internal\"]",
   "  by_zone     = { for k, v in var.subnets : k => v.cidr... }",
   "  replicas    = var.environment == \"prod\" ? 3 : 1",
   "}",
   "",
   "data \"aws_ami\" \"base\" {",
   "  most_recent = true",
   "  owners      = [\"amazon\"]",
   "  filter {",
   "    name   = \"name\"",
   "    values = [\"al2023-ami-*-x86_64\"]",
   "  }",
   "}",
   "",
   "resource \"aws_instance\" \"api\" {",
   "  count         = local.replicas",
   "  ami           = data.aws_ami.base.id",
   "  instance_type = \"t3.small\"",
   "  tags          = merge(local.common_tags, { Name = \"${local.name_prefix}-api-${count.index}\" })",
   "  user_data     = <<-EOT",
   "    #!/bin/sh",
   "    echo \"starting ${local.name_prefix}\"",
   "  EOT",
   "",
   "  dynamic \"ebs_block_device\" {",
   "    for_each = var.environment == \"prod\" ? [1] : []",
   "    content {",
   "      device_name = \"/dev/sdf\"",
   "      volume_size = 50",
   "    }",
   "  }",
   "",
   "  lifecycle {",
   "    create_before_destroy = true",
   "    ignore_changes        = [tags[\"LastSeen\"]]",
   "  }",
   "}",
   "",
   "module \"network\" {",
   "  source  = \"./modules/network\"",
   "  subnets = var.subnets",
   "}",
   "",
   "output \"api_addresses\" {",
   "  value     = aws_instance.api[*].private_ip",
   "  sensitive = false",
   "}",
   "",
   "/* a block comment */",
   "// a line comment"
  ]
 },
 "graphql": {
  "schema.graphql": [
   "# Schema and operations for the tide service",
   "schema {",
   "  query: Query",
   "  mutation: Mutation",
   "  subscription: Subscription",
   "}",
   "",
   "\"\"\"",
   "A harbour with tide tables.",
   "\"\"\"",
   "type Harbour implements Node & Named @key(fields: \"id\") {",
   "  id: ID!",
   "  name: String!",
   "  \"Position as latitude and longitude\"",
   "  position: Position",
   "  tides(days: Int = 1, units: Units = METRIC): [Tide!]!",
   "  tags: [String!] @deprecated(reason: \"use labels\")",
   "}",
   "",
   "interface Node {",
   "  id: ID!",
   "}",
   "",
   "interface Named {",
   "  name: String!",
   "}",
   "",
   "type Position {",
   "  latitude: Float!",
   "  longitude: Float!",
   "}",
   "",
   "type Tide {",
   "  at: DateTime!",
   "  height: Float!",
   "  kind: TideKind!",
   "}",
   "",
   "enum TideKind {",
   "  HIGH",
   "  LOW",
   "}",
   "",
   "enum Units {",
   "  METRIC",
   "  IMPERIAL",
   "}",
   "",
   "scalar DateTime @specifiedBy(url: \"https://www.rfc-editor.org/rfc/rfc3339\")",
   "",
   "union SearchResult = Harbour | Tide",
   "",
   "input HarbourInput {",
   "  name: String!",
   "  position: PositionInput",
   "  tags: [String!] = []",
   "}",
   "",
   "input PositionInput {",
   "  latitude: Float!",
   "  longitude: Float!",
   "}",
   "",
   "directive @key(fields: String!) on OBJECT | INTERFACE",
   "",
   "type Query {",
   "  harbour(id: ID!): Harbour",
   "  search(text: String!, first: Int = 10): [SearchResult!]!",
   "}",
   "",
   "type Mutation {",
   "  addHarbour(input: HarbourInput!): Harbour!",
   "}",
   "",
   "type Subscription {",
   "  tideChanged(harbourId: ID!): Tide!",
   "}",
   "",
   "extend type Harbour {",
   "  labels: [String!]!",
   "}",
   "",
   "query HarbourTides($id: ID!, $days: Int = 3, $withPosition: Boolean = false) {",
   "  harbour(id: $id) {",
   "    ...HarbourFields",
   "    position @include(if: $withPosition) {",
   "      latitude",
   "      longitude",
   "    }",
   "    nextThree: tides(days: $days, units: IMPERIAL) {",
   "      at",
   "      height",
   "    }",
   "  }",
   "  search(text: \"st ives\") {",
   "    __typename",
   "    ... on Harbour {",
   "      name",
   "    }",
   "    ... on Tide {",
   "      kind",
   "    }",
   "  }",
   "}",
   "",
   "mutation AddHarbour {",
   "  addHarbour(input: { name: \"Mousehole\", position: { latitude: 50.083, longitude: -5.538 }, tags: [\"small\", \"cornwall\"] }) {",
   "    id",
   "  }",
   "}",
   "",
   "subscription OnTide($harbourId: ID!) {",
   "  tideChanged(harbourId: $harbourId) {",
   "    at",
   "    kind",
   "  }",
   "}",
   "",
   "fragment HarbourFields on Harbour {",
   "  id",
   "  name",
   "}"
  ]
 },
 "protobuf": {
  "tides.proto": [
   "// Tide service wire types",
   "syntax = \"proto3\";",
   "",
   "package tidepool.v1;",
   "",
   "import \"google/protobuf/timestamp.proto\";",
   "import public \"tidepool/v1/common.proto\";",
   "",
   "option go_package = \"example.com/tidepool/gen/tidepoolv1;tidepoolv1\";",
   "option java_multiple_files = true;",
   "",
   "/* A harbour and its position */",
   "message Harbour {",
   "  string id = 1;",
   "  string name = 2;",
   "  Position position = 3;",
   "  repeated string tags = 4 [deprecated = true];",
   "  map<string, string> labels = 5;",
   "  optional string region = 6;",
   "",
   "  message Position {",
   "    double latitude = 1;",
   "    double longitude = 2;",
   "  }",
   "",
   "  reserved 7, 9 to 11;",
   "  reserved \"legacy_code\";",
   "}",
   "",
   "enum TideKind {",
   "  option allow_alias = true;",
   "  TIDE_KIND_UNSPECIFIED = 0;",
   "  TIDE_KIND_HIGH = 1;",
   "  TIDE_KIND_LOW = 2;",
   "  TIDE_KIND_EBB = 2;",
   "}",
   "",
   "message Tide {",
   "  google.protobuf.Timestamp at = 1;",
   "  float height_m = 2;",
   "  TideKind kind = 3;",
   "  oneof source {",
   "    string station = 4;",
   "    bytes model_blob = 5;",
   "  }",
   "}",
   "",
   "message ListTidesRequest {",
   "  string harbour_id = 1;",
   "  int32 days = 2;",
   "  uint64 page_token = 3;",
   "  bool metric = 4;",
   "}",
   "",
   "message ListTidesResponse {",
   "  repeated Tide tides = 1;",
   "  sint64 next_page_token = 2;",
   "}",
   "",
   "service TideService {",
   "  option deprecated = false;",
   "  rpc GetHarbour(GetHarbourRequest) returns (Harbour);",
   "  rpc ListTides(ListTidesRequest) returns (ListTidesResponse) {",
   "    option idempotency_level = NO_SIDE_EFFECTS;",
   "  }",
   "  rpc WatchTides(ListTidesRequest) returns (stream Tide);",
   "  rpc Upload(stream Tide) returns (ListTidesResponse);",
   "}",
   "",
   "message GetHarbourRequest {",
   "  string id = 1;",
   "}"
  ]
 },
 "dart": {
  "harbour.dart": [
   "// Harbours and tide tables",
   "import 'dart:async';",
   "import 'dart:convert' show jsonDecode, jsonEncode;",
   "import 'package:meta/meta.dart' as meta;",
   "",
   "enum TideKind { high, low }",
   "",
   "typedef Height = double;",
   "",
   "abstract class Named {",
   "  String get name;",
   "}",
   "",
   "mixin Describable on Named {",
   "  String describe() => 'Harbour $name';",
   "}",
   "",
   "class Position {",
   "  final double latitude;",
   "  final double longitude;",
   "  const Position(this.latitude, this.longitude);",
   "",
   "  factory Position.fromJson(Map<String, dynamic> json) =>",
   "      Position(json['lat'] as double, json['lon'] as double);",
   "",
   "  @override",
   "  String toString() => '(${latitude.toStringAsFixed(3)}, $longitude)';",
   "}",
   "",
   "class Harbour extends Named with Describable implements Comparable<Harbour> {",
   "  @override",
   "  final String name;",
   "  final Position? position;",
   "  final List<Tide> _tides = [];",
   "  static int created = 0;",
   "",
   "  Harbour(this.name, {this.position}) {",
   "    created++;",
   "  }",
   "",
   "  Harbour.unnamed() : this('unnamed');",
   "",
   "  int get tideCount => _tides.length;",
   "",
   "  set firstTide(Tide tide) => _tides.insert(0, tide);",
   "",
   "  void add(Tide tide, {bool sort = true}) {",
   "    _tides.add(tide);",
   "    if (sort) {",
   "      _tides.sort((a, b) => a.at.compareTo(b.at));",
   "    }",
   "  }",
   "",
   "  Iterable<Tide> highs() sync* {",
   "    for (final tide in _tides) {",
   "      if (tide.kind == TideKind.high) yield tide;",
   "    }",
   "  }",
   "",
   "  @override",
   "  int compareTo(Harbour other) => name.compareTo(other.name);",
   "}",
   "",
   "class Tide {",
   "  final DateTime at;",
   "  final Height height;",
   "  final TideKind kind;",
   "  Tide(this.at, this.height, this.kind);",
   "}",
   "",
   "extension HeightFormat on Height {",
   "  String get metres => '${toStringAsFixed(2)} m';",
   "}",
   "",
   "T firstOr<T>(List<T> items, T fallback) => items.isEmpty ? fallback : items.first;",
   "",
   "Future<Harbour> loadHarbour(String source) async {",
   "  final decoded = jsonDecode(source) as Map<String, dynamic>;",
   "  final harbour = Harbour(decoded['name'] as String);",
   "  await Future<void>.delayed(const Duration(milliseconds: 10));",
   "  try {",
   "    for (var i = 0; i < 3; i++) {",
   "      harbour.add(Tide(DateTime(2026, 11, 13 + i), 1.5 * i, i.isEven ? TideKind.high : TideKind.low));",
   "    }",
   "  } on FormatException catch (error, stack) {",
   "    print('bad table: $error\\n$stack');",
   "    rethrow;",
   "  } finally {",
   "    print(jsonEncode({'loaded': harbour.name}));",
   "  }",
   "  return harbour;",
   "}",
   "",
   "String label(TideKind kind) {",
   "  switch (kind) {",
   "    case TideKind.high:",
   "      return 'HW';",
   "    case TideKind.low:",
   "      return 'LW';",
   "  }",
   "}",
   "",
   "void main(List<String> args) async {",
   "  final harbour = await loadHarbour('{\"name\": \"St Ives\"}');",
   "  final heights = harbour.highs().map((t) => t.height.metres).toList();",
   "  var count = harbour.tideCount;",
   "  count ??= 0;",
   "  final maybe = harbour.position?.latitude ?? 0.0;",
   "  final squares = [for (var i = 0; i < count; i++) i * i, if (count > 2) ...heights];",
   "  while (count > 0) {",
   "    count--;",
   "  }",
   "  print('${harbour.describe()}: $heights $maybe $squares ${label(TideKind.low)} ${firstOr(args, 'none')}');",
   "}"
  ]
 },
 "scala": {
  "Harbour.scala": [
   "// Harbours and tide tables",
   "package tidepool",
   "",
   "import java.time.Instant",
   "import scala.collection.mutable",
   "import scala.concurrent.{ExecutionContext, Future}",
   "import scala.util.{Failure, Success, Try}",
   "",
   "sealed trait TideKind",
   "object TideKind {",
   "  case object High extends TideKind",
   "  case object Low extends TideKind",
   "}",
   "",
   "final case class Position(latitude: Double, longitude: Double)",
   "",
   "final case class Tide(at: Instant, height: Double, kind: TideKind)",
   "",
   "trait Named {",
   "  def name: String",
   "  def describe: String = s\"Harbour $name\"",
   "}",
   "",
   "class Harbour(val name: String, val position: Option[Position] = None) extends Named with Ordered[Harbour] {",
   "  private val tides = mutable.ArrayBuffer.empty[Tide]",
   "  private var revision: Int = 0",
   "  lazy val key: String = name.toLowerCase.replace(' ', '-')",
   "",
   "  def add(tide: Tide): Unit = {",
   "    tides += tide",
   "    revision += 1",
   "  }",
   "",
   "  def highs: Seq[Tide] = tides.filter(_.kind == TideKind.High).toSeq",
   "",
   "  def mean: Option[Double] =",
   "    if (tides.isEmpty) None else Some(tides.map(_.height).sum / tides.size)",
   "",
   "  override def compare(that: Harbour): Int = name.compareTo(that.name)",
   "",
   "  def label(kind: TideKind): String = kind match {",
   "    case TideKind.High => \"HW\"",
   "    case TideKind.Low  => \"LW\"",
   "  }",
   "}",
   "",
   "object Harbour {",
   "  def apply(name: String): Harbour = new Harbour(name)",
   "",
   "  implicit val byName: Ordering[Harbour] = Ordering.by(_.name)",
   "",
   "  def parse(line: String): Either[String, Tide] =",
   "    line.split(',').toList match {",
   "      case at :: height :: kind :: Nil if height.nonEmpty =>",
   "        Try(Tide(Instant.parse(at), height.toDouble, if (kind == \"H\") TideKind.High else TideKind.Low)) match {",
   "          case Success(tide) => Right(tide)",
   "          case Failure(err)  => Left(s\"bad row: ${err.getMessage}\")",
   "        }",
   "      case _ => Left(\"expected three fields\")",
   "    }",
   "",
   "  def loadAll(lines: Seq[String])(implicit ec: ExecutionContext): Future[Harbour] = Future {",
   "    val harbour = Harbour(\"St Ives\")",
   "    for {",
   "      line <- lines",
   "      tide <- parse(line).toOption",
   "      if tide.height > 0",
   "    } harbour.add(tide)",
   "    harbour",
   "  }",
   "",
   "  def largest[A <: Named](items: List[A])(score: A => Double): Option[A] =",
   "    items.sortBy(score).lastOption",
   "",
   "  val table: Map[String, Int] = Map(\"high\" -> 1, \"low\" -> 2)",
   "  val (first, second) = (\"a\", 2)",
   "  var counter = 0",
   "  while (counter < 3) {",
   "    counter += 1",
   "  }",
   "  val doubled: PartialFunction[Int, Int] = { case n if n % 2 == 0 => n * 2 }",
   "  val text =",
   "    \"\"\"a raw",
   "      |multi-line string\"\"\".stripMargin",
   "}"
  ]
 },
 "elixir": {
  "harbour.ex": [
   "# Harbours and tide tables",
   "defmodule Tidepool.Harbour do",
   "  @moduledoc \"\"\"",
   "  A harbour and its tides.",
   "  \"\"\"",
   "",
   "  alias Tidepool.{Position, Tide}",
   "  import Enum, only: [map: 2, filter: 2]",
   "  require Logger",
   "  use GenServer",
   "",
   "  @default_days 3",
   "  @type kind :: :high | :low",
   "  @enforce_keys [:name]",
   "  defstruct [:name, position: nil, tides: []]",
   "",
   "  @doc \"Builds a harbour.\"",
   "  @spec new(String.t(), keyword()) :: %__MODULE__{}",
   "  def new(name, opts \\\\ []) when is_binary(name) do",
   "    %__MODULE__{name: name, position: Keyword.get(opts, :position)}",
   "  end",
   "",
   "  def add(%__MODULE__{tides: tides} = harbour, %Tide{} = tide) do",
   "    %{harbour | tides: [tide | tides]}",
   "  end",
   "",
   "  def highs(harbour), do: filter(harbour.tides, &(&1.kind == :high))",
   "",
   "  def mean(%__MODULE__{tides: []}), do: nil",
   "",
   "  def mean(%__MODULE__{tides: tides}) do",
   "    tides",
   "    |> map(& &1.height)",
   "    |> Enum.sum()",
   "    |> Kernel./(length(tides))",
   "  end",
   "",
   "  def label(kind) do",
   "    case kind do",
   "      :high -> \"HW\"",
   "      :low -> \"LW\"",
   "      other -> raise ArgumentError, \"unknown kind: #{inspect(other)}\"",
   "    end",
   "  end",
   "",
   "  def describe(harbour, days \\\\ @default_days) do",
   "    cond do",
   "      harbour.tides == [] -> \"#{harbour.name}: no tides\"",
   "      days > 7 -> \"#{harbour.name}: too far ahead\"",
   "      true -> \"#{harbour.name}: #{length(harbour.tides)} tides\"",
   "    end",
   "  end",
   "",
   "  def parse(line) do",
   "    with [at, height, kind] <- String.split(line, \",\"),",
   "         {value, \"\"} <- Float.parse(height),",
   "         {:ok, time, _offset} <- DateTime.from_iso8601(at) do",
   "      {:ok, %Tide{at: time, height: value, kind: if(kind == \"H\", do: :high, else: :low)}}",
   "    else",
   "      _ -> {:error, :bad_row}",
   "    end",
   "  end",
   "",
   "  defp squares(n), do: for(i <- 1..n, rem(i, 2) == 0, into: [], do: i * i)",
   "",
   "  defmacro unless_empty(list, do: block) do",
   "    quote do",
   "      if unquote(list) != [], do: unquote(block)",
   "    end",
   "  end",
   "",
   "  @impl true",
   "  def init(state), do: {:ok, state}",
   "",
   "  @impl true",
   "  def handle_call({:add, tide}, _from, state) do",
   "    Logger.info(\"adding #{inspect(tide)}\")",
   "    {:reply, :ok, add(state, tide)}",
   "  end",
   "",
   "  def safe_mean(harbour) do",
   "    try do",
   "      mean(harbour)",
   "    rescue",
   "      ArithmeticError -> 0.0",
   "    after",
   "      Logger.debug(~s(mean computed for \"#{harbour.name}\"))",
   "    end",
   "  end",
   "",
   "  def table, do: %{\"high\" => 1, \"low\" => 2, sigil: ~w(a b c)a, charlist: ~c\"abc\", tuple: {1, 2.5, 0x1F}}",
   "",
   "  def doubled, do: fn x -> x * 2 end",
   "end",
   "",
   "defprotocol Tidepool.Describe do",
   "  def text(value)",
   "end",
   "",
   "defimpl Tidepool.Describe, for: Tidepool.Harbour do",
   "  def text(harbour), do: Tidepool.Harbour.describe(harbour)",
   "end"
  ]
 },
 "zig": {
  "harbour.zig": [
   "//! Harbours and tide tables",
   "const std = @import(\"std\");",
   "const Allocator = std.mem.Allocator;",
   "",
   "pub const TideKind = enum { high, low };",
   "",
   "pub const Position = struct {",
   "    latitude: f64,",
   "    longitude: f64 = 0.0,",
   "};",
   "",
   "pub const Tide = struct {",
   "    at: i64,",
   "    height: f32,",
   "    kind: TideKind,",
   "",
   "    pub fn label(self: Tide) []const u8 {",
   "        return switch (self.kind) {",
   "            .high => \"HW\",",
   "            .low => \"LW\",",
   "        };",
   "    }",
   "};",
   "",
   "const Shape = union(enum) {",
   "    point: Position,",
   "    none,",
   "};",
   "",
   "pub const HarbourError = error{ Full, Unnamed };",
   "",
   "pub fn Harbour(comptime capacity: usize) type {",
   "    return struct {",
   "        const Self = @This();",
   "",
   "        name: []const u8,",
   "        position: ?Position = null,",
   "        tides: [capacity]Tide = undefined,",
   "        count: usize = 0,",
   "",
   "        pub fn init(name: []const u8) HarbourError!Self {",
   "            if (name.len == 0) return HarbourError.Unnamed;",
   "            return Self{ .name = name };",
   "        }",
   "",
   "        pub fn add(self: *Self, tide: Tide) !void {",
   "            if (self.count >= capacity) return error.Full;",
   "            self.tides[self.count] = tide;",
   "            self.count += 1;",
   "        }",
   "",
   "        pub fn mean(self: *const Self) ?f32 {",
   "            if (self.count == 0) return null;",
   "            var sum: f32 = 0;",
   "            for (self.tides[0..self.count]) |tide| {",
   "                sum += tide.height;",
   "            }",
   "            return sum / @as(f32, @floatFromInt(self.count));",
   "        }",
   "    };",
   "}",
   "",
   "fn squares(allocator: Allocator, n: usize) ![]u32 {",
   "    const out = try allocator.alloc(u32, n);",
   "    errdefer allocator.free(out);",
   "    var i: usize = 0;",
   "    while (i < n) : (i += 1) {",
   "        out[i] = @intCast(i * i);",
   "    }",
   "    return out;",
   "}",
   "",
   "pub fn main() !void {",
   "    var gpa = std.heap.GeneralPurposeAllocator(.{}){};",
   "    defer _ = gpa.deinit();",
   "    const allocator = gpa.allocator();",
   "",
   "    var harbour = try Harbour(8).init(\"St Ives\");",
   "    try harbour.add(.{ .at = 1, .height = 4.2, .kind = .high });",
   "    harbour.add(.{ .at = 2, .height = 0.9, .kind = .low }) catch |err| {",
   "        std.debug.print(\"add failed: {}\\n\", .{err});",
   "    };",
   "",
   "    const values = try squares(allocator, 4);",
   "    defer allocator.free(values);",
   "",
   "    const shape: Shape = if (harbour.position) |p| .{ .point = p } else .none;",
   "    const text = switch (shape) {",
   "        .point => |p| p.latitude,",
   "        .none => 0.0,",
   "    };",
   "    const multi =",
   "        \\\\a multi-line",
   "        \\\\string literal",
   "    ;",
   "    outer: for (values, 0..) |value, index| {",
   "        if (index == 2) continue :outer;",
   "        if (value > 100) break;",
   "    }",
   "    const mask: u8 = 0b1010 | (1 << 2);",
   "    std.debug.print(\"{s}: {?d} {d} {s} {d}\\n\", .{ harbour.name, harbour.mean(), text, multi, mask });",
   "}",
   "",
   "test \"mean of two tides\" {",
   "    var harbour = try Harbour(2).init(\"Test\");",
   "    try harbour.add(.{ .at = 1, .height = 2.0, .kind = .high });",
   "    try std.testing.expectEqual(@as(?f32, 2.0), harbour.mean());",
   "}"
  ]
 },
 "haskell": {
  "Harbour.hs": [
   "{-# LANGUAGE LambdaCase #-}",
   "-- | Harbours and tide tables",
   "module Tidepool.Harbour",
   "  ( Harbour (..)",
   "  , TideKind (..)",
   "  , addTide",
   "  , meanHeight",
   "  ) where",
   "",
   "import Data.List (sortOn)",
   "import qualified Data.Map.Strict as Map",
   "import Data.Maybe (fromMaybe, mapMaybe)",
   "",
   "data TideKind = High | Low",
   "  deriving (Eq, Show, Ord)",
   "",
   "data Position = Position",
   "  { latitude  :: Double",
   "  , longitude :: Double",
   "  } deriving (Eq, Show)",
   "",
   "data Tide = Tide",
   "  { tideAt     :: Int",
   "  , tideHeight :: Double",
   "  , tideKind   :: TideKind",
   "  } deriving (Eq, Show)",
   "",
   "data Harbour = Harbour",
   "  { harbourName     :: String",
   "  , harbourPosition :: Maybe Position",
   "  , harbourTides    :: [Tide]",
   "  }",
   "",
   "newtype Metres = Metres Double",
   "",
   "type Table = Map.Map String [Tide]",
   "",
   "class Describe a where",
   "  describe :: a -> String",
   "  describe _ = \"thing\"",
   "",
   "instance Describe Harbour where",
   "  describe h = \"Harbour \" ++ harbourName h",
   "",
   "instance Show Metres where",
   "  show (Metres m) = show m ++ \" m\"",
   "",
   "addTide :: Tide -> Harbour -> Harbour",
   "addTide tide harbour = harbour { harbourTides = sortOn tideAt (tide : harbourTides harbour) }",
   "",
   "meanHeight :: Harbour -> Maybe Double",
   "meanHeight harbour",
   "  | null tides = Nothing",
   "  | otherwise = Just (total / fromIntegral (length tides))",
   "  where",
   "    tides = harbourTides harbour",
   "    total = sum (map tideHeight tides)",
   "",
   "label :: TideKind -> String",
   "label = \\case",
   "  High -> \"HW\"",
   "  Low -> \"LW\"",
   "",
   "highs :: Harbour -> [Tide]",
   "highs h = [t | t <- harbourTides h, tideKind t == High]",
   "",
   "parseRow :: String -> Either String Tide",
   "parseRow line =",
   "  case words line of",
   "    [at, height, kind] ->",
   "      let k = if kind == \"H\" then High else Low",
   "       in Right (Tide (read at) (read height) k)",
   "    _ -> Left (\"bad row: \" ++ line)",
   "",
   "squares :: Int -> [Int]",
   "squares n = map (\\x -> x * x) (filter even [1 .. n])",
   "",
   "compose :: (b -> c) -> (a -> b) -> a -> c",
   "compose f g = f . g",
   "",
   "table :: [Harbour] -> Table",
   "table = foldr insert Map.empty",
   "  where",
   "    insert h = Map.insertWith (++) (harbourName h) (harbourTides h)",
   "",
   "main :: IO ()",
   "main = do",
   "  let harbour = addTide (Tide 1 4.2 High) (Harbour \"St Ives\" Nothing [])",
   "      mean = fromMaybe 0 (meanHeight harbour)",
   "  putStrLn (describe harbour)",
   "  rows <- pure (mapMaybe (either (const Nothing) Just . parseRow) [\"2 0.9 L\", \"bad\"])",
   "  mapM_ (putStrLn . label . tideKind) rows",
   "  print (Metres mean, squares 6, length (highs harbour) `max` 1)"
  ]
 },
 "ocaml": {
  "harbour.ml": [
   "(* Harbours and tide tables *)",
   "open Printf",
   "",
   "type tide_kind = High | Low",
   "",
   "type position = { latitude : float; longitude : float }",
   "",
   "type tide = { at : int; height : float; kind : tide_kind }",
   "",
   "type harbour = {",
   "  name : string;",
   "  position : position option;",
   "  mutable tides : tide list;",
   "}",
   "",
   "type shape = Point of position | Named of string * int | Nothing",
   "",
   "exception Unnamed of string",
   "",
   "module type DESCRIBE = sig",
   "  type t",
   "  val describe : t -> string",
   "end",
   "",
   "module Harbour_describe : DESCRIBE with type t = harbour = struct",
   "  type t = harbour",
   "  let describe h = \"Harbour \" ^ h.name",
   "end",
   "",
   "module StringMap = Map.Make (String)",
   "",
   "let make ?position name =",
   "  if String.length name = 0 then raise (Unnamed \"empty name\")",
   "  else { name; position; tides = [] }",
   "",
   "let add harbour tide = harbour.tides <- tide :: harbour.tides",
   "",
   "let label = function High -> \"HW\" | Low -> \"LW\"",
   "",
   "let rec sum = function [] -> 0.0 | t :: rest -> t.height +. sum rest",
   "",
   "let mean harbour =",
   "  match harbour.tides with",
   "  | [] -> None",
   "  | tides -> Some (sum tides /. float_of_int (List.length tides))",
   "",
   "let highs harbour = List.filter (fun t -> t.kind = High) harbour.tides",
   "",
   "let parse_row line =",
   "  match String.split_on_char ',' line with",
   "  | [ at; height; kind ] -> (",
   "      try",
   "        Ok { at = int_of_string at; height = float_of_string height; kind = (if kind = \"H\" then High else Low) }",
   "      with Failure msg -> Error (\"bad row: \" ^ msg))",
   "  | _ -> Error \"expected three fields\"",
   "",
   "let squares n =",
   "  let out = ref [] in",
   "  for i = 1 to n do",
   "    if i mod 2 = 0 then out := (i * i) :: !out",
   "  done;",
   "  List.rev !out",
   "",
   "let describe_shape = function",
   "  | Point { latitude; longitude } when latitude > 0.0 -> sprintf \"north %f %f\" latitude longitude",
   "  | Point _ -> \"south\"",
   "  | Named (name, n) -> name ^ string_of_int n",
   "  | Nothing -> \"nothing\"",
   "",
   "class counter =",
   "  object (self)",
   "    val mutable count = 0",
   "    method next = count <- count + 1; count",
   "    method reset = count <- 0; self",
   "  end",
   "",
   "let table = StringMap.(empty |> add \"high\" 1 |> add \"low\" 2)",
   "",
   "let () =",
   "  let harbour = make ~position:{ latitude = 50.2; longitude = -5.5 } \"St Ives\" in",
   "  add harbour { at = 1; height = 4.2; kind = High };",
   "  let lines = [ \"2,0.9,L\"; \"bad\" ] in",
   "  List.iter (fun line -> match parse_row line with Ok t -> add harbour t | Error e -> prerr_endline e) lines;",
   "  let c = new counter in",
   "  let (first, _second) = (c#next, c#next) in",
   "  let i = ref 0 in",
   "  while !i < 2 do incr i done;",
   "  printf \"%s: %s %d %d %s %d\\n\" (Harbour_describe.describe harbour)",
   "    (match mean harbour with Some m -> string_of_float m | None -> \"-\")",
   "    (List.length (highs harbour)) first (label Low) (StringMap.cardinal table)"
  ]
 }
