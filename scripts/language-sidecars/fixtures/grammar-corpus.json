 "yaml": {
  "deploy.yaml": [
   "%YAML 1.2",
   "---",
   "# Deployment for the billing service",
   "apiVersion: apps/v1",
   "kind: Deployment",
   "metadata:",
   "  name: billing",
   "  labels: &labels",
   "    app: billing",
   "    tier: backend",
   "  annotations:",
   "    description: \"Handles invoices \\u2014 and refunds\"",
   "    note: 'single ''quoted'' text'",
   "spec:",
   "  replicas: 3",
   "  paused: false",
   "  minReadySeconds: ~",
   "  selector:",
   "    matchLabels: *labels",
   "  template:",
   "    metadata:",
   "      labels:",
   "        <<: *labels",
   "        version: \"1.4.2\"",
   "    spec:",
   "      containers:",
   "        - name: api",
   "          image: registry.example.com/billing:1.4.2",
   "          args: [--port, \"8080\", --log-level=info]",
   "          env:",
   "            - { name: DATABASE_URL, valueFrom: { secretKeyRef: { name: db, key: url } } }",
   "            - name: FEATURE_FLAGS",
   "              value: >-",
   "                invoices,",
   "                refunds,",
   "                exports",
   "          resources:",
   "            limits: {cpu: 500m, memory: 256Mi}",
   "          livenessProbe:",
   "            httpGet:",
   "              path: /healthz",
   "              port: 8080",
   "            initialDelaySeconds: 5",
   "            periodSeconds: 10.5",
   "      initContainers: []",
   "---",
   "apiVersion: v1",
   "kind: ConfigMap",
   "metadata:",
   "  name: billing-config",
   "data:",
   "  startup.sh: |",
   "    #!/bin/sh",
   "    set -eu",
   "    exec /app/billing --config /etc/billing.toml",
   "  motd: |+",
   "    Welcome.",
   "",
   "  ratio: !!float 0.75",
   "  ports: !!seq",
   "    - 8080",
   "    - 9090",
   "  ? [composite, key]",
   "  : composite value",
   "  octal: 0o644",
   "  hex: 0xFF",
   "  date: 2026-11-13",
   "  time: 2026-11-13T21:30:00Z",
   "  multi word plain scalar: this value",
   "    continues on the next line",
   "..."
  ],
  "workflow.yml": [
   "name: build",
   "on:",
   "  push:",
   "    branches: [main, 'release/**']",
   "  pull_request:",
   "    types:",
   "      - opened",
   "      - synchronize",
   "env:",
   "  NODE_VERSION: 22",
   "  CACHE_KEY: \"deps-${{ hashFiles('**/lockfile') }}\"",
   "jobs:",
   "  test:",
   "    runs-on: ${{ matrix.os }}",
   "    strategy:",
   "      fail-fast: false",
   "      matrix:",
   "        os: [ubuntu-latest, macos-latest, windows-latest]",
   "        include:",
   "          - os: ubuntu-latest",
   "            coverage: true",
   "    steps:",
   "      - uses: actions/checkout@v4",
   "      - name: Install",
   "        run: |",
   "          corepack enable",
   "          pnpm install --frozen-lockfile",
   "      - name: Test",
   "        if: matrix.coverage != true",
   "        run: pnpm test -- --reporter=dot",
   "      - name: Summary",
   "        run: >",
   "          echo \"tests finished",
   "          on ${{ matrix.os }}\""
  ]
 },
 "markdown": {
  "README.md": [
   "---",
   "title: Tidepool",
   "tags: [cli, tides]",
   "---",
   "",
   "# Tidepool",
   "",
   "A small command-line tool that prints **tide tables** for a harbour, with",
   "*sunrise* and `moon phase` beside them. See the [manual](docs/manual.md) or the",
   "![logo](assets/logo.png \"The Tidepool logo\").",
   "",
   "Setext heading",
   "--------------",
   "",
   "> A tide table is a promise the sea usually keeps.",
   ">",
   "> > Nested quotes are allowed.",
   "",
   "## Install",
   "",
   "1. Download the archive",
   "2. Unpack it:",
   "   - on macOS, into `/usr/local`",
   "   - on Linux, into `~/.local`",
   "3. Run `tidepool --version`",
   "",
   "- [x] harbours",
   "- [ ] offline tables",
   "",
   "```sh",
   "curl -fsSL https://example.com/install.sh | sh",
   "tidepool harbour add \"St Ives\"",
   "```",
   "",
   "~~~json",
   "{ \"harbour\": \"St Ives\", \"days\": 3 }",
   "~~~",
   "",
   "    tidepool today",
   "",
   "## Options",
   "",
   "| Flag        | Meaning            | Default |",
   "|:------------|:------------------:|--------:|",
   "| `--days N`  | how many days      |       1 |",
   "| `--metric`  | metres, not feet   |     off |",
   "",
   "* * *",
   "",
   "<details>",
   "<summary>Why not a web page?</summary>",
   "Because a terminal is already open.",
   "</details>",
   "",
   "Line one ends with two spaces  ",
   "and line two follows it. A footnote reference[^1] and an autolink",
   "<https://example.com> close the paragraph.",
   "",
   "[^1]: Tables come from the harbour authority.",
   "[manual]: docs/manual.md \"The manual\""
  ]
 },
 "sql": {
  "schema.sql": [
   "-- Orders schema and the queries the reports run",
   "DROP TABLE IF EXISTS order_items;",
   "",
   "CREATE TABLE customers (",
   "    id          INTEGER PRIMARY KEY,",
   "    email       VARCHAR(255) NOT NULL UNIQUE,",
   "    full_name   TEXT NOT NULL,",
   "    country     CHAR(2) DEFAULT 'GB',",
   "    created_at  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP",
   ");",
   "",
   "CREATE TABLE orders (",
   "    id           BIGINT PRIMARY KEY,",
   "    customer_id  INTEGER NOT NULL REFERENCES customers (id),",
   "    status       VARCHAR(20) NOT NULL DEFAULT 'open',",
   "    total        DECIMAL(10, 2) NOT NULL CHECK (total >= 0),",
   "    placed_at    DATE NOT NULL,",
   "    CONSTRAINT orders_status_check CHECK (status IN ('open', 'paid', 'void'))",
   ");",
   "",
   "CREATE INDEX orders_customer_idx ON orders (customer_id, placed_at);",
   "",
   "ALTER TABLE customers ADD COLUMN phone VARCHAR(32);",
   "",
   "/* seed rows */",
   "INSERT INTO customers (id, email, full_name, country)",
   "VALUES (1, 'ada@example.com', 'Ada Lovelace', 'GB'),",
   "       (2, 'alan@example.com', 'Alan Turing', 'GB');",
   "",
   "BEGIN;",
   "UPDATE orders",
   "SET status = 'paid', total = total * 1.2",
   "WHERE id = 42 AND status <> 'void';",
   "DELETE FROM orders WHERE placed_at < '2020-01-01';",
   "COMMIT;",
   "",
   "SELECT c.full_name, COUNT(o.id) AS order_count, COALESCE(SUM(o.total), 0) AS spent",
   "FROM customers AS c",
   "LEFT JOIN orders AS o ON o.customer_id = c.id",
   "WHERE c.country IN ('GB', 'IE') AND c.email LIKE '%@example.com'",
   "GROUP BY c.full_name",
   "HAVING COUNT(o.id) > 1",
   "ORDER BY spent DESC, c.full_name ASC",
   "LIMIT 10 OFFSET 20;",
   "",
   "WITH monthly AS (",
   "    SELECT customer_id, EXTRACT(MONTH FROM placed_at) AS month, SUM(total) AS total",
   "    FROM orders",
   "    WHERE placed_at BETWEEN '2026-01-01' AND '2026-12-31'",
   "    GROUP BY customer_id, EXTRACT(MONTH FROM placed_at)",
   ")",
   "SELECT customer_id,",
   "       month,",
   "       total,",
   "       ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY total DESC) AS rank_in_year,",
   "       CASE WHEN total >= 1000 THEN 'large' WHEN total >= 100 THEN 'medium' ELSE 'small' END AS band",
   "FROM monthly",
   "WHERE EXISTS (SELECT 1 FROM customers WHERE customers.id = monthly.customer_id AND phone IS NOT NULL);",
   "",
   "SELECT id, CAST(total AS INTEGER) FROM orders WHERE status = 'open'",
   "UNION ALL",
   "SELECT id, 0 FROM orders WHERE status = 'void';",
   "",
   "CREATE VIEW paid_orders AS",
   "SELECT o.id, o.total, c.email",
   "FROM orders o",
   "INNER JOIN customers c ON c.id = o.customer_id",
   "WHERE o.status = 'paid';"
  ]
 },
 "dockerfile": {
  "Dockerfile": [
   "# syntax=docker/dockerfile:1",
   "ARG NODE_VERSION=22",
   "FROM node:${NODE_VERSION}-alpine AS build",
   "LABEL org.opencontainers.image.source=\"https://example.com/tidepool\" \\",
   "      org.opencontainers.image.licenses=MIT",
   "ENV NODE_ENV=production \\",
   "    PORT=8080",
   "WORKDIR /app",
   "COPY package.json pnpm-lock.yaml ./",
   "RUN --mount=type=cache,target=/root/.pnpm-store \\",
   "    corepack enable \\",
   "    && pnpm install --frozen-lockfile",
   "COPY . .",
   "RUN pnpm build && rm -rf node_modules/.cache",
   "",
   "FROM gcr.io/distroless/nodejs22-debian12",
   "ARG BUILD_REF",
   "ENV BUILD_REF=${BUILD_REF:-unknown}",
   "WORKDIR /app",
   "COPY --from=build --chown=1000:1000 /app/dist ./dist",
   "ADD https://example.com/ca.pem /etc/ssl/ca.pem",
   "EXPOSE 8080/tcp",
   "VOLUME [\"/data\"]",
   "USER 1000:1000",
   "STOPSIGNAL SIGTERM",
   "HEALTHCHECK --interval=30s --timeout=3s CMD [\"node\", \"dist/health.js\"]",
   "SHELL [\"/bin/sh\", \"-c\"]",
   "ONBUILD RUN echo \"built on top of tidepool\"",
   "ENTRYPOINT [\"node\", \"dist/server.js\"]",
   "CMD [\"--port\", \"8080\"]"
  ]
 },
 "lua": {
  "inventory.lua": [
   "-- Inventory: a small module with a class, closures and iterators",
   "local json = require(\"json\")",
   "",
   "local Inventory = {}",
   "Inventory.__index = Inventory",
   "",
   "local MAX_ITEMS <const> = 64",
   "local DEFAULTS = { capacity = 16, name = \"crate\", tags = { \"wood\", \"iron\" }, [1] = \"first\" }",
   "",
   "--[[ A long comment",
   "     that spans lines ]]",
   "function Inventory.new(name, capacity)",
   "  local self = setmetatable({}, Inventory)",
   "  self.name = name or DEFAULTS.name",
   "  self.capacity = capacity or DEFAULTS.capacity",
   "  self.items = {}",
   "  return self",
   "end",
   "",
   "function Inventory:add(item, count)",
   "  count = count or 1",
   "  if #self.items >= self.capacity then",
   "    return nil, \"full\"",
   "  elseif count <= 0 then",
   "    error(\"count must be positive: \" .. tostring(count), 2)",
   "  else",
   "    self.items[#self.items + 1] = { name = item, count = count }",
   "  end",
   "  return true",
   "end",
   "",
   "function Inventory:total()",
   "  local sum = 0",
   "  for _, entry in ipairs(self.items) do",
   "    sum = sum + entry.count",
   "  end",
   "  return sum",
   "end",
   "",
   "local function counter(step)",
   "  local n = 0",
   "  return function(...)",
   "    local extra = select(\"#\", ...)",
   "    n = n + step + extra",
   "    return n",
   "  end",
   "end",
   "",
   "local function describe(inv)",
   "  local lines = {}",
   "  for i = 1, #inv.items, 1 do",
   "    local entry = inv.items[i]",
   "    lines[#lines + 1] = string.format(\"%2d %s x%d\", i, entry.name, entry.count)",
   "  end",
   "  local i = 0",
   "  while i < 3 do",
   "    i = i + 1",
   "    if i == 2 then goto continue end",
   "    lines[#lines + 1] = (\"-\"):rep(i)",
   "    ::continue::",
   "  end",
   "  repeat",
   "    i = i - 1",
   "  until i <= 0",
   "  return table.concat(lines, \"\\n\")",
   "end",
   "",
   "local ok, err = pcall(function()",
   "  local inv = Inventory.new(\"chest\", 2)",
   "  inv:add(\"nail\", 40)",
   "  inv:add('rope')",
   "  local text = [[",
   "    a long string",
   "    with \"quotes\"]]",
   "  local nested = [==[ ]] still inside ]==]",
   "  local mask = (0xFF & 0x0F) | (1 << 4) ~ 3",
   "  local half, ratio = 7 // 2, 2 ^ 0.5",
   "  print(describe(inv), text, nested, mask, half, ratio, json ~= nil, not ok)",
   "end)",
   "",
   "return Inventory"
  ]
 },
 "make": {
  "Makefile": [
   "# Build the tidepool binary and its docs",
   "SHELL := /bin/sh",
   "CC ?= cc",
   "CFLAGS += -Wall -Wextra -O2",
   "PREFIX = /usr/local",
   "SRCS := $(wildcard src/*.c)",
   "OBJS := $(patsubst src/%.c,build/%.o,$(SRCS))",
   "VERSION := $(shell git describe --tags 2>/dev/null || echo dev)",
   "export VERSION",
   "",
   "ifeq ($(DEBUG),1)",
   "CFLAGS += -g -DDEBUG",
   "else ifdef RELEASE",
   "CFLAGS += -DNDEBUG",
   "else",
   "CFLAGS += -DDEFAULT",
   "endif",
   "",
   "define banner",
   "\t@echo \"== $(1) ==\"",
   "endef",
   "",
   "include config.mk",
   "-include local.mk",
   "",
   ".PHONY: all clean install test",
   ".DEFAULT_GOAL := all",
   "",
   "all: build/tidepool docs",
   "",
   "build/tidepool: $(OBJS) | build",
   "\t$(CC) $(LDFLAGS) -o $@ $^",
   "",
   "build/%.o: src/%.c src/tidepool.h",
   "\t$(call banner,compile $<)",
   "\t$(CC) $(CFLAGS) -DVERSION='\"$(VERSION)\"' -c $< -o $@",
   "",
   "build:",
   "\tmkdir -p $@",
   "",
   "docs: docs/manual.md",
   "\tpandoc $< -o build/manual.html",
   "",
   "test: build/tidepool",
   "\t@for t in tests/*.sh; do \\",
   "\t\tsh $$t || exit 1; \\",
   "\tdone",
   "",
   "install: all",
   "\tinstall -d $(DESTDIR)$(PREFIX)/bin",
   "\tinstall -m 755 build/tidepool $(DESTDIR)$(PREFIX)/bin/",
   "",
   "clean:",
   "\t-rm -rf build"
  ]
 },
 "cmake": {
  "CMakeLists.txt": [
   "# Tidepool build",
   "cmake_minimum_required(VERSION 3.20)",
   "project(tidepool VERSION 1.4.2 LANGUAGES C CXX)",
   "",
   "set(CMAKE_CXX_STANDARD 20)",
   "set(CMAKE_CXX_STANDARD_REQUIRED ON)",
   "option(TIDEPOOL_BUILD_TESTS \"Build the unit tests\" ON)",
   "",
   "find_package(Threads REQUIRED)",
   "find_package(ZLIB 1.2 QUIET)",
   "",
   "set(SOURCES",
   "    src/main.cpp",
   "    src/harbour.cpp",
   "    src/table.cpp)",
   "",
   "add_library(tidecore STATIC ${SOURCES})",
   "target_include_directories(tidecore PUBLIC",
   "    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>",
   "    $<INSTALL_INTERFACE:include>)",
   "target_compile_definitions(tidecore PRIVATE TIDEPOOL_VERSION=\"${PROJECT_VERSION}\")",
   "target_link_libraries(tidecore PUBLIC Threads::Threads)",
   "",
   "if(ZLIB_FOUND AND NOT WIN32)",
   "  target_link_libraries(tidecore PRIVATE ZLIB::ZLIB)",
   "  message(STATUS \"zlib ${ZLIB_VERSION_STRING} found\")",
   "elseif(MSVC)",
   "  target_compile_options(tidecore PRIVATE /W4)",
   "else()",
   "  message(WARNING \"building without compression\")",
   "endif()",
   "",
   "function(tidepool_add_tool name)",
   "  add_executable(${name} ${ARGN})",
   "  target_link_libraries(${name} PRIVATE tidecore)",
   "  install(TARGETS ${name} RUNTIME DESTINATION bin)",
   "endfunction()",
   "",
   "macro(tidepool_note text)",
   "  message(STATUS \"note: ${text}\")",
   "endmacro()",
   "",
   "tidepool_add_tool(tidepool tools/cli.cpp)",
   "tidepool_note(\"configured for ${CMAKE_SYSTEM_NAME}\")",
   "",
   "foreach(lang IN ITEMS en fr de)",
   "  configure_file(i18n/${lang}.txt.in ${CMAKE_BINARY_DIR}/i18n/${lang}.txt @ONLY)",
   "endforeach()",
   "",
   "set(counter 0)",
   "while(counter LESS 3)",
   "  math(EXPR counter \"${counter} + 1\")",
   "endwhile()",
   "",
   "if(TIDEPOOL_BUILD_TESTS)",
   "  enable_testing()",
   "  add_subdirectory(tests)",
   "  add_test(NAME smoke COMMAND tidepool --version)",
   "endif()",
   "",
   "#[[ A bracket comment",
   "    over two lines ]]",
   "set(LONG_TEXT [=[",
   "  raw text with ${no} expansion",
   "]=])"
  ]
 },
